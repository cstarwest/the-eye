{
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/path/to/your/repo"
      ],
      "allowedTools": []
    },
    "github": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "ghp_..."
      },
      "allowedTools": []
    },
    "docs": {
      "url": "https://example.com/mcp",
      "authorization_token": "optional-bearer-token",
      "allowedTools": []
    }
  }
}
